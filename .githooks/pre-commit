#!/usr/bin/env bash
# Shim: pwsh -File requires a .ps1 extension, but Git's hooksPath mechanism
# requires the exact extensionless name "pre-commit". Dispatch to the real
# script alongside this file.
set -euo pipefail
hook_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec pwsh -NoProfile -File "${hook_dir}/pre-commit.ps1" "$@"
